# Supabase (로컬: `pnpm exec supabase status -o env` 값 사용)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# 사건 1건당 AI 비용 상한 (원). 초안·재생성·AI 재판장을 합쳐 이 금액을 넘지 않게 호출한다
AI_BUDGET_KRW_PER_CASE=200
# 원/달러 환율 (상한 계산용, 대략이면 됨)
KRW_PER_USD=1400

# 선택: 카카오 공유하기
NEXT_PUBLIC_KAKAO_JS_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 시스템 프롬프트 끝에 붙는 유출 감지용 문자열 (아무 랜덤 문자열)
PROMPT_CANARY=
# 피고·배심원 링크 토큰 파생용 비밀키 (32자 이상, `openssl rand -hex 32`)
TOKEN_SECRET=
