# Supabase (로컬: `pnpm exec supabase status -o env` 값 사용)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# 사건 1건당 AI 비용 상한 (원). 초안·재생성·AI 재판장을 합쳐 이 금액을 넘지 않게 호출한다
AI_BUDGET_KRW_PER_CASE=200
# 원/달러 환율 (상한 계산용, 대략이면 됨)
KRW_PER_USD=1400

# 선택: 카카오 공유하기
NEXT_PUBLIC_KAKAO_JS_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 시스템 프롬프트 끝에 붙는 유출 감지용 문자열 (아무 랜덤 문자열)
PROMPT_CANARY=
# 피고·배심원 링크 토큰 파생용 비밀키 (32자 이상, `openssl rand -hex 32`)
TOKEN_SECRET=

# 광고 보상형 AI 변호인 (Google Ad Manager)
# 보상형 광고 단위 경로. 예: /12345678/lawyer_rewarded  (비우면 배포 환경에서는 변호인 기능이 숨겨짐)
NEXT_PUBLIC_GAM_REWARDED_UNIT=
# Ad Manager 가 알려 준 ads.txt 내용 (여러 줄은 \n 으로). 예: google.com, pub-0000000000000000, DIRECT, f08c47fec0942fa0
ADS_TXT=
# 1 이면 배포 환경에서도 테스트용 가짜 광고 사용 (개발 환경은 기본으로 가짜 광고)
NEXT_PUBLIC_AD_MOCK=
# AI 변호인 1회 비용 상한 (원). 사건당 상한과 따로 센다
AI_LAWYER_BUDGET_KRW=40

# 이용약관·개인정보처리방침에 표시할 운영자 이름과 문의 이메일
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
